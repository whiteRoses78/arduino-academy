/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# webapp-saas-erstellen
.env.local
.mcp.json
.claude/settings.local.json
# .env.example ist Vorlage ohne Secrets -> committen (Negation nach .env*)
!.env.example

# lokale Design-Backups (Theme-Quelle lebt versioniert in src/app/globals.css)
/docs/design/

# Unterrichtsmaterial (Modularbeiten, Loesungen, Zugangskarten mit Klartext-
